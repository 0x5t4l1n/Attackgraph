# AttackGraph Configuration
# Copy to .env and modify as needed

# Database
DATABASE_URL=sqlite+aiosqlite:///./attackgraph.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# AI Assistant (optional)
AI_ENABLED=false
AI_API_BASE=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Crawler defaults
CRAWLER_MAX_DEPTH=3
CRAWLER_MAX_CONCURRENT=5
CRAWLER_MAX_PAGES=500
CRAWLER_RATE_LIMIT=10.0
